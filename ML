        "# 7. Neural Network baseline\n",
        "def build_nn(dropout1=0.30, dropout2=0.20, learning_rate=0.001):\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.layers.Input(shape=(X_train_scaled.shape[1],)),\n",
        "        tf.keras.layers.Dense(32, activation=\"relu\"),\n",
        "        tf.keras.layers.Dropout(dropout1),\n",
        "        tf.keras.layers.Dense(16, activation=\"relu\"),\n",
        "        tf.keras.layers.Dropout(dropout2),\n",
        "        tf.keras.layers.Dense(1, activation=\"sigmoid\")\n",
        "    ])\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(learning_rate=learning_rate),\n",
        "        loss=\"binary_crossentropy\",\n",
        "        metrics=[\"accuracy\"]\n",
        "    )\n",
        "    return model\n",
        "\n",
        "def train_nn(dropout1, dropout2, name):\n",
        "    model = build_nn(dropout1, dropout2)\n",
        "    callbacks = [\n",
        "        tf.keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=15, restore_best_weights=True),\n",
        "        tf.keras.callbacks.ReduceLROnPlateau(monitor=\"val_loss\", factor=0.5, patience=5, min_lr=1e-5)\n",
        "    ]\n",
        "    hist = model.fit(\n",
        "        X_train_scaled, y_train,\n",
        "        validation_data=(X_val_scaled, y_val),\n",
        "        epochs=100, batch_size=16, verbose=0, callbacks=callbacks\n",
        "    )\n",
        "    model.save(MODELS/f\"{name}.keras\")\n",
        "    return model, hist\n",
        "\n",
        "nn_baseline, nn_baseline_history = train_nn(0.30, 0.20, \"nn_baseline\")\n",
        "nn_tuned, nn_tuned_history = train_nn(0.40, 0.30, \"nn_tuned\")\n",
        "\n",
        "def plot_history(history, filename, title):\n",
        "    h = pd.DataFrame(history.history)\n",
        "    fig, ax = plt.subplots(1,2, figsize=(12,4))\n",
        "    ax[0].plot(h[\"loss\"], label=\"train\"); ax[0].plot(h[\"val_loss\"], label=\"validation\")\n",
        "    ax[0].set_title(\"Loss\"); ax[0].set_xlabel(\"Epoch\"); ax[0].legend()\n",
        "    ax[1].plot(h[\"accuracy\"], label=\"train\"); ax[1].plot(h[\"val_accuracy\"], label=\"validation\")\n",
        "    ax[1].set_title(\"Accuracy\"); ax[1].set_xlabel(\"Epoch\"); ax[1].legend()\n",
        "    fig.suptitle(title); plt.tight_layout()\n",
        "    plt.savefig(FIG/filename, dpi=200); plt.show()\n",
        "\n",
        "plot_history(nn_baseline_history, \"07_nn_baseline_learning_curves.png\", \"Neural Network baseline learning curves\")\n",
        "plot_history(nn_tuned_history, \"08_nn_tuned_learning_curves.png\", \"Neural Network tuned learning curves\")\n",
        "\n",
        "# 8. Random Forest baseline and hyperparameter tuning (raw features; scaling not required)\n",
        "rf_baseline = RandomForestClassifier(n_estimators=100, random_state=SEED, n_jobs=-1)\n",
        "rf_baseline.fit(X_train, y_train)\n",
        "\n",
        "rf_grid = GridSearchCV(\n",
        "    RandomForestClassifier(random_state=SEED, n_jobs=-1),\n",
        "    param_grid={\n",
        "        \"n_estimators\": [100, 200],\n",
        "        \"max_depth\": [None, 5, 10],\n",
        "        \"min_samples_split\": [2, 5],\n",
        "        \"min_samples_leaf\": [1, 2],\n",
        "        \"max_features\": [\"sqrt\", \"log2\"]\n",
        "    },\n",
        "    scoring=\"f1_macro\", cv=StratifiedKFold(5, shuffle=True, random_state=SEED),\n",
        "    n_jobs=-1, refit=True\n",
        ")\n",
        "rf_grid.fit(X_train, y_train)\n",
        "rf_tuned = rf_grid.best_estimator_\n",
        "print(\"RF best parameters:\", rf_grid.best_params_)\n",
        "print(\"RF best mean CV macro-F1:\", rf_grid.best_score_)\n",
        "\n",
        "importances = pd.Series(rf_tuned.feature_importances_, index=X.columns).sort_values(ascending=False)\n",
        "display(importances.head(10).to_frame(\"importance\"))\n",
        "plt.figure(figsize=(9,6))\n",
        "importances.head(10).sort_values().plot(kind=\"barh\")\n",
        "plt.title(\"Top 10 Random Forest feature importances\")\n",
        "plt.xlabel(\"Importance\"); plt.tight_layout()\n",
        "plt.savefig(FIG/\"09_rf_feature_importance.png\", dpi=200); plt.show()\n",
        "\n",
        "# 9. SVM baseline and tuning. Pipeline ensures scaler is fitted inside each CV fold.\n",
        "svm_baseline = Pipeline([\n",
        "    (\"scaler\", StandardScaler()),\n",
        "    (\"svc\", SVC(kernel=\"rbf\", C=1, gamma=\"scale\", class_weight=None))\n",
        "])\n",
        "svm_baseline.fit(X_train, y_train)\n",
        "\n",
        "svm_pipe = Pipeline([\n",
        "    (\"scaler\", StandardScaler()),\n",
        "    (\"svc\", SVC(kernel=\"rbf\", class_weight=None))\n",
        "])\n",
        "svm_grid = GridSearchCV(\n",
        "    svm_pipe,\n",
        "    param_grid={\n",
        "        \"svc__C\": [0.1, 1, 10, 100],\n",
        "        \"svc__gamma\": [\"scale\", \"auto\", 0.001, 0.01, 0.1]\n",
        "    },\n",
        "    scoring=\"f1_macro\", cv=StratifiedKFold(5, shuffle=True, random_state=SEED),\n",
        "    n_jobs=-1, refit=True\n",
        ")\n",
        "svm_grid.fit(X_train, y_train)\n",
        "svm_tuned = svm_grid.best_estimator_\n",
        "print(\"SVM best parameters:\", svm_grid.best_params_)\n",
        "print(\"SVM best mean CV macro-F1:\", svm_grid.best_score_)"
