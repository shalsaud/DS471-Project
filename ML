        "# 10. Validation metrics (use validation data for model selection, not final claims)\n",
        "models_val = {\n",
        "    \"Neural Network\": (nn_tuned, X_val_scaled, \"nn\"),\n",
        "    \"Random Forest\": (rf_tuned, X_val, \"sk\"),\n",
        "    \"SVM\": (svm_tuned, X_val, \"sk\")\n",
        "}\n",
        "def positive_scores(model, Xdata, kind):\n",
        "    if kind == \"nn\":\n",
        "        return model.predict(Xdata, verbose=0).ravel()\n",
        "    if hasattr(model, \"predict_proba\"):\n",
        "        return model.predict_proba(Xdata)[:,1]\n",
        "    return model.decision_function(Xdata)\n",
        "\n",
        "val_rows = []\n",
        "for name, (model, xv, kind) in models_val.items():\n",
        "    scores = positive_scores(model, xv, kind)\n",
        "    pred = (scores >= 0.5).astype(int) if kind == \"nn\" else model.predict(xv)\n",
        "    val_rows.append({\n",
        "        \"Model\": name,\n",
        "        \"Accuracy\": accuracy_score(y_val, pred),\n",
        "        \"Precision_macro\": precision_score(y_val, pred, average=\"macro\", zero_division=0),\n",
        "        \"Recall_malignant\": recall_score(y_val, pred, pos_label=0, zero_division=0),\n",
        "        \"F1_macro\": f1_score(y_val, pred, average=\"macro\", zero_division=0),\n",
        "        \"ROC_AUC_benign_positive\": roc_auc_score(y_val, scores)\n",
